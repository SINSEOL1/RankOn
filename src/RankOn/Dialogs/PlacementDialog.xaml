<Window x:Class="RankOn.Dialogs.PlacementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="전적 추가"
        Width="360"
        Height="282"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Window.Resources>
        <Style x:Key="PlacementButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#3A424D"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="등수 선택"
                   FontSize="20"
                   FontWeight="SemiBold"/>

        <TextBlock Grid.Row="1"
                   Text="최근 전적에 추가할 등수를 선택하세요."
                   Margin="0,8,0,0"
                   Foreground="{DynamicResource MutedTextBrush}"/>

        <primitives:UniformGrid Grid.Row="2"
                                Rows="2"
                                Columns="4"
                                Margin="0,20,0,0">
            <Button Content="1등" Tag="1" Background="#C99326" Click="Placement_Click" Style="{StaticResource PlacementButtonStyle}"/>
            <Button Content="2등" Tag="2" Background="#8F9AA8" Click="Placement_Click" Style="{StaticResource PlacementButtonStyle}"/>
            <Button Content="3등" Tag="3" Background="#A86A43" Click="Placement_Click" Style="{StaticResource PlacementButtonStyle}"/>
            <Button Content="4등" Tag="4" Click="Placement_Click" Style="{StaticResource PlacementButtonStyle}"/>
            <Button Content="5등" Tag="5" Click="Placement_Click" Style="{StaticResource PlacementButtonStyle}"/>
            <Button Content="6등" Tag="6" Click="Placement_Click" Style="{StaticResource PlacementButtonStyle}"/>
            <Button Content="7등" Tag="7" Click="Placement_Click" Style="{StaticResource PlacementButtonStyle}"/>
            <Button Content="8등" Tag="8" Click="Placement_Click" Style="{StaticResource PlacementButtonStyle}"/>
        </primitives:UniformGrid>

        <Button Grid.Row="3"
                Content="취소"
                Width="82"
                HorizontalAlignment="Right"
                Margin="0,18,0,0"
                Click="Cancel_Click"
                Style="{StaticResource SecondaryButtonStyle}"/>
    </Grid>
</Window>
