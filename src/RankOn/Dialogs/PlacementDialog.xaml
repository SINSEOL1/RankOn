<Window x:Class="RankOn.Dialogs.PlacementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="전적 추가"
        Width="360"
        Height="250"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="등수 선택"
                   FontSize="20"
                   FontWeight="SemiBold"/>

        <TextBlock Grid.Row="1"
                   Text="최근 전적에 추가할 등수를 선택하세요."
                   Margin="0,8,0,0"
                   Foreground="{DynamicResource MutedTextBrush}"/>

        <primitives:UniformGrid Grid.Row="2"
                                Rows="2"
                                Columns="4"
                                Margin="0,22,0,0">
            <Button Content="1등" Tag="1" Margin="4" Height="46" Click="Placement_Click" Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="2등" Tag="2" Margin="4" Height="46" Click="Placement_Click" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button Content="3등" Tag="3" Margin="4" Height="46" Click="Placement_Click" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button Content="4등" Tag="4" Margin="4" Height="46" Click="Placement_Click" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button Content="5등" Tag="5" Margin="4" Height="46" Click="Placement_Click" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button Content="6등" Tag="6" Margin="4" Height="46" Click="Placement_Click" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button Content="7등" Tag="7" Margin="4" Height="46" Click="Placement_Click" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button Content="8등" Tag="8" Margin="4" Height="46" Click="Placement_Click" Style="{StaticResource SecondaryButtonStyle}"/>
        </primitives:UniformGrid>

        <Button Grid.Row="3"
                Content="취소"
                Width="82"
                HorizontalAlignment="Right"
                Margin="0,16,0,0"
                Click="Cancel_Click"
                Style="{StaticResource SecondaryButtonStyle}"/>
    </Grid>
</Window>
