<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>RankOn</AssemblyName>
    <RootNamespace>RankOn</RootNamespace>
    <Version>1.1.3</Version>
    <ApplicationIcon>Resources\RankOn.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Resource Include="Resources\rank-tiers.png" Condition="Exists('Resources\rank-tiers.png')" />
    <Resource Include="Resources\RankOn.ico" />
  </ItemGroup>
</Project>
