<UserControl x:Class="RankOn.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">
    <Grid Margin="28">
        <Border Padding="22" Background="{DynamicResource SurfaceBrush}" CornerRadius="12">
            <StackPanel>
                <TextBlock Text="랭크온" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <TextBlock x:Name="VersionText" Margin="0,5,0,0" Foreground="{DynamicResource MutedTextBrush}"/>
                <TextBlock Text="이터널 리턴을 위한 비공식 랭크 오버레이 프로그램입니다." Margin="0,22,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBlock Text="개발자 문의" Margin="0,28,0,0" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Discord · sinseol" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <Button Content="복사" Margin="12,0,0,0" Click="CopyDiscord_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                    <Button x:Name="UpdateButton" Content="업데이트 확인" Click="CheckUpdate_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                    <Button Content="GitHub 열기" Margin="8,0,0,0" Click="OpenGitHub_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                </StackPanel>
                <TextBlock x:Name="UpdateStatusText" Margin="0,10,0,0" Foreground="{DynamicResource MutedTextBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
