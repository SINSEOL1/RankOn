<UserControl x:Class="RankOn.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <Border Padding="22" Background="{DynamicResource SurfaceBrush}" CornerRadius="12">
                <StackPanel>
                    <TextBlock Text="테마" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="시스템" Tag="System" Click="ThemeButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button Content="Light" Tag="Light" Margin="8,0,0,0" Click="ThemeButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button Content="Dark" Tag="Dark" Margin="8,0,0,0" Click="ThemeButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Margin="0,18,0,0" Padding="22" Background="{DynamicResource SurfaceBrush}" CornerRadius="12">
                <StackPanel>
                    <TextBlock Text="언어" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <ComboBox x:Name="LanguageComboBox" Width="220" Margin="0,16,0,0" HorizontalAlignment="Left">
                        <ComboBoxItem Content="한국어" Tag="ko-KR" IsSelected="True"/>
                        <ComboBoxItem Content="English" Tag="en-US"/>
                        <ComboBoxItem Content="日本語" Tag="ja-JP"/>
                        <ComboBoxItem Content="简体中文" Tag="zh-CN"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Margin="0,18,0,0" Padding="22" Background="{DynamicResource SurfaceBrush}" CornerRadius="12">
                <StackPanel>
                    <TextBlock Text="데이터" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="자동 랭크 갱신 60초"
                               Margin="0,12,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
