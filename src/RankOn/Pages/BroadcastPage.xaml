<UserControl x:Class="RankOn.Pages.BroadcastPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <Border Padding="22" Background="{DynamicResource SurfaceBrush}" CornerRadius="12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="OBS Browser Source" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock x:Name="ServerStatusText" Margin="0,7,0,0"/>
                        </StackPanel>
                        <Button x:Name="ToggleServerButton" Grid.Column="1" Click="ToggleServer_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                    </Grid>
                    <TextBlock Text="주소" Margin="0,22,0,7" Foreground="{DynamicResource MutedTextBrush}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Padding="12,10" Background="{DynamicResource SurfaceStrongBrush}" CornerRadius="8">
                            <TextBlock x:Name="AddressText" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </Border>
                        <Button Grid.Column="1" Content="복사" Margin="8,0,0,0" Click="CopyAddress_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button Grid.Column="2" Content="미리보기" Margin="8,0,0,0" Click="OpenPreview_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                    </Grid>
                    <TextBlock Text="권장 크기 1200 × 720 · 투명 배경" Margin="0,12,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
            </Border>
            <Border Margin="0,18,0,0" Padding="22" Background="{DynamicResource SurfaceBrush}" CornerRadius="12">
                <StackPanel>
                    <TextBlock Text="OBS 등록 방법" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="1. OBS에서 브라우저 소스를 추가합니다." Margin="0,16,0,0" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="2. 위 주소를 URL에 입력합니다." Margin="0,8,0,0" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="3. 너비 1200, 높이 720으로 설정합니다." Margin="0,8,0,0" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="PC 오버레이와 방송 출력은 서로 독립적으로 켜고 끌 수 있습니다." Margin="0,16,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
