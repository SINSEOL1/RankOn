<UserControl x:Class="RankOn.Pages.OverlayPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <Border Padding="22" Background="{DynamicResource SurfaceBrush}" CornerRadius="12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="PC 오버레이" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="방송 출력과 독립적으로 Windows 화면에 표시됩니다." Margin="0,7,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                        <CheckBox x:Name="EnabledCheckBox" Grid.Column="1" Content="사용" VerticalAlignment="Center" Click="EnabledCheckBox_Click"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button x:Name="PositionModeButton" Click="PositionModeButton_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                        <Button Content="위치 초기화" Margin="8,0,0,0" Click="ResetPosition_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                        <TextBlock x:Name="PositionText" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Margin="0,18,0,0" Padding="22" Background="{DynamicResource SurfaceBrush}" CornerRadius="12">
                <StackPanel>
                    <TextBlock Text="표시 설정" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="크기" Margin="0,18,0,5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                        <Slider x:Name="ScaleSlider" Minimum="50" Maximum="160" ValueChanged="ScaleSlider_ValueChanged"/>
                        <TextBlock x:Name="ScaleValueText" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="투명도" Margin="0,18,0,5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                        <Slider x:Name="OpacitySlider" Minimum="20" Maximum="100" ValueChanged="OpacitySlider_ValueChanged"/>
                        <TextBlock x:Name="OpacityValueText" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <CheckBox x:Name="TopmostCheckBox" Content="항상 위" Margin="0,18,0,0" Checked="WindowOption_Changed" Unchecked="WindowOption_Changed"/>
                    <CheckBox x:Name="ClickThroughCheckBox" Content="클릭 통과" Checked="WindowOption_Changed" Unchecked="WindowOption_Changed"/>
                    <CheckBox x:Name="LockCheckBox" Content="오버레이 잠금" Checked="WindowOption_Changed" Unchecked="WindowOption_Changed"/>
                    <TextBlock Text="표시/숨기기 단축키  Ctrl + Shift + R" Margin="0,16,0,0" Foreground="{DynamicResource MutedTextBrush}"/>
                    <TextBlock Text="PC 오버레이는 작업표시줄과 Alt+Tab에 표시되지 않습니다." Margin="0,5,0,0" Foreground="{DynamicResource MutedTextBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
