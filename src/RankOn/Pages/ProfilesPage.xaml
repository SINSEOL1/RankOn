<UserControl x:Class="RankOn.Pages.ProfilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Padding="22"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="12">
            <StackPanel>
                <TextBlock Text="이터널 리턴 프로필"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                <TextBlock Text="현재 인게임 닉네임을 입력하면 랭크온이 UID를 저장하고 이후 60초마다 랭크를 자동 갱신합니다."
                           Margin="0,7,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>

                <Grid Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="NicknameTextBox"
                             Height="40"
                             Padding="11,8"
                             FontSize="15"
                             KeyDown="NicknameTextBox_KeyDown"/>

                    <Button x:Name="RegisterButton"
                            Grid.Column="1"
                            Content="등록"
                            Margin="8,0,0,0"
                            Click="RegisterButton_Click"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                </Grid>

                <TextBlock x:Name="RegistrationStatusText"
                           Margin="0,12,0,0"
                           Foreground="{DynamicResource MutedTextBrush}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Padding="22"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="12">
            <StackPanel>
                <TextBlock Text="현재 프로필"
                           FontSize="13"
                           Foreground="{DynamicResource MutedTextBrush}"/>

                <TextBlock x:Name="CurrentNicknameText"
                           Text="등록된 프로필 없음"
                           Margin="0,13,0,0"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                <TextBlock x:Name="CurrentRankText"
                           Margin="0,7,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
