<UserControl x:Class="RankOn.Pages.DesignPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">
    <Grid Margin="28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Padding="22"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="12">
            <StackPanel>
                <TextBlock Text="프리셋"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                <RadioButton Content="Standard"
                             Margin="0,18,0,0"
                             IsChecked="True"
                             Foreground="{DynamicResource PrimaryTextBrush}"/>
                <RadioButton Content="Compact"
                             Margin="0,12,0,0"
                             Foreground="{DynamicResource PrimaryTextBrush}"/>
                <RadioButton Content="Minimal"
                             Margin="0,12,0,0"
                             Foreground="{DynamicResource PrimaryTextBrush}"/>
                <RadioButton Content="Vertical"
                             Margin="0,12,0,0"
                             Foreground="{DynamicResource PrimaryTextBrush}"/>
                <RadioButton Content="Stream Bar"
                             Margin="0,12,0,0"
                             Foreground="{DynamicResource PrimaryTextBrush}"/>

                <Separator Margin="0,22,0,18"
                           Background="{DynamicResource BorderBrush}"/>

                <TextBlock Text="표시 항목"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                <TextBlock Text="목표 RP 표시"
                           Margin="0,16,0,7"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>

                <ComboBox x:Name="TargetRpDisplayComboBox"
                          Height="38"
                          SelectionChanged="TargetRpDisplayComboBox_SelectionChanged">
                    <ComboBoxItem Content="자동" Tag="Auto"/>
                    <ComboBoxItem Content="다음 티어" Tag="NextTier"/>
                    <ComboBoxItem Content="데미갓" Tag="Demigod"/>
                    <ComboBoxItem Content="이터니티" Tag="Eternity"/>
                    <ComboBoxItem Content="숨김" Tag="Hidden"/>
                </ComboBox>

                <TextBlock Text="자동은 현재 티어에 맞는 다음 목표를 표시합니다."
                           Margin="0,9,0,0"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Foreground="{DynamicResource MutedTextBrush}"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="2"
                Padding="22"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="12">
            <StackPanel>
                <TextBlock Text="실시간 미리보기"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                <Border Margin="0,24,0,0"
                        Padding="18"
                        HorizontalAlignment="Left"
                        Background="#E6101218"
                        CornerRadius="14">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="62"
                                Height="62"
                                Background="#22FFFFFF"
                                CornerRadius="12">
                            <TextBlock Text="ET"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#B9C2D0"
                                       FontWeight="Bold"/>
                        </Border>

                        <StackPanel Margin="16,0,24,0">
                            <TextBlock Text="SINSEOL"
                                       Foreground="White"
                                       FontWeight="Bold"/>

                            <TextBlock Text="이터니티 · 9,800 RP · #104"
                                       Margin="0,6,0,0"
                                       Foreground="White"
                                       FontSize="17"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="시즌 종료까지 54일"
                                       Margin="0,5,0,0"
                                       Foreground="#B9C2D0"
                                       FontSize="12"/>
                        </StackPanel>

                        <TextBlock Text="+128 RP"
                                   Foreground="#70D6A6"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
