<UserControl x:Class="RankOn.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Padding="22" Background="{DynamicResource SurfaceBrush}" CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="82"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="70"
                            Height="70"
                            Background="{DynamicResource SurfaceStrongBrush}"
                            CornerRadius="14"
                            VerticalAlignment="Top">
                        <TextBlock x:Name="RankBadgeText"
                                   Text="RANK"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource MutedTextBrush}"/>
                    </Border>

                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="NicknameText"
                                   Text="프로필을 등록해주세요"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>

                        <TextBlock x:Name="TierText"
                                   Text="프로필 페이지에서 닉네임을 등록하면 시작됩니다."
                                   Margin="0,7,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock x:Name="RpText"
                                       Text="— RP"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock x:Name="RankText"
                                       Text="—"
                                       Margin="12,0,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>

                        <TextBlock x:Name="SeasonText"
                                   Margin="0,9,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}"/>

                        <TextBlock x:Name="CutText"
                                   Margin="0,5,0,0"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Padding="22" Background="{DynamicResource SurfaceBrush}" CornerRadius="12">
                <StackPanel>
                    <TextBlock Text="이번 세션"
                               FontSize="13"
                               Foreground="{DynamicResource MutedTextBrush}"/>

                    <TextBlock x:Name="SessionDeltaText"
                               Text="0 RP"
                               Margin="0,14,0,0"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PositiveBrush}"/>

                    <TextBlock x:Name="SessionStartText"
                               Text="시작 RP —"
                               Margin="0,5,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button Content="새 세션"
                                Click="NewSession_Click"
                                Style="{StaticResource PrimaryButtonStyle}"/>
                        <Button Content="직접 입력"
                                Margin="8,0,0,0"
                                Click="ManualSession_Click"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    Grid.ColumnSpan="3"
                    Padding="22"
                    Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="PC 오버레이"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="ON"
                                   Margin="0,5,0,0"
                                   Foreground="{DynamicResource PositiveBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="방송 출력"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock x:Name="BroadcastStatusText"
                                   Margin="0,5,0,0"
                                   Foreground="{DynamicResource PositiveBrush}"/>
                    </StackPanel>

                    <Button x:Name="RefreshButton"
                            Grid.Column="2"
                            Content="새로고침"
                            Click="Refresh_Click"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                </Grid>
            </Border>

            <Border Grid.Row="4"
                    Grid.ColumnSpan="3"
                    Padding="18"
                    Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="12">
                <TextBlock x:Name="StatusText"
                           Text="프로필을 등록해주세요."
                           Foreground="{DynamicResource MutedTextBrush}"/>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
